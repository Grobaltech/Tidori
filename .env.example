# Copy to .env for local dev. In Cloudflare Pages add the same names under
# Settings > Variables and Secrets (they are public, build-time values).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-PUBLIC-KEY

# Optional: link to your payment page (Paystack, Stripe Payment Link, PayPal, etc.)
VITE_GIVE_URL=
# Optional: YouTube embed URL for the "Watch Video" button, e.g. https://www.youtube.com/embed/VIDEO_ID
VITE_VIDEO_URL=
