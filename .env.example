# Copy to .env for local development. Set the same values in the Cloudflare
# Pages/Workers BUILD environment and trigger a fresh deployment.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR-PUBLIC-KEY

# Backwards compatibility: VITE_SUPABASE_ANON_KEY is also accepted.
# Never use a Supabase secret/service_role key in a VITE_ variable.

# Optional: link to your payment page (Paystack, Stripe Payment Link, PayPal, etc.)
VITE_GIVE_URL=
# Optional: YouTube embed URL for the "Watch Video" button, e.g. https://www.youtube.com/embed/VIDEO_ID
VITE_VIDEO_URL=
